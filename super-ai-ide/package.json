{
    "name": "super-ai-ide",
    "publisher": "me",
    "displayName": "Super AI IDE",
    "description": "A super AI IDE extension",
    "version": "0.0.1",
    "repository": {
        "type": "git",
        "url": "https://github.com/your-username/super-ai-ide"
    },
    "license": "MIT",
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [],
    "main": "./out/extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "super-ai-ide-sidebar",
                    "title": "Super AI",
                    "icon": "media/robot.svg"
                }
            ]
        },
        "views": {
            "super-ai-ide-sidebar": [
                {
                    "type": "webview",
                    "id": "super-ai-ide.sidebarView",
                    "name": "AI Chat"
                }
            ]
        },
        "configuration": {
            "title": "Super AI IDE",
            "properties": {
                "super-ai-ide.openRouterApiKey": {
                    "type": "string",
                    "default": "",
                    "description": "Your OpenRouter API Key",
                    "order": 1
                },
                "super-ai-ide.model": {
                    "type": "string",
                    "default": "deepseek/deepseek-chat",
                    "description": "The Model ID to use via OpenRouter (recommend models with tool calling support)",
                    "order": 2
                },
                "super-ai-ide.provider": {
                    "type": "string",
                    "enum": [
                        "openrouter",
                        "openai",
                        "anthropic"
                    ],
                    "default": "openrouter",
                    "description": "The AI Provider to use",
                    "order": 3
                },
                "super-ai-ide.baseUrl": {
                    "type": "string",
                    "default": "",
                    "description": "Custom Base URL for API calls (optional)",
                    "order": 4
                },
                "super-ai-ide.execution.mode": {
                    "type": "string",
                    "enum": [
                        "local",
                        "docker"
                    ],
                    "default": "local",
                    "description": "Where to execute terminal commands: 'local' (host machine) or 'docker' (container)",
                    "order": 5
                },
                "super-ai-ide.execution.containerId": {
                    "type": "string",
                    "default": "",
                    "description": "Docker Container ID or Name (required if execution mode is 'docker')",
                    "order": 6
                },
                "super-ai-ide.execution.shell": {
                    "type": "string",
                    "default": "",
                    "description": "Specific shell to use (e.g., /bin/bash, powershell). Leave empty for system default.",
                    "order": 7
                },
                "super-ai-ide.mcpServers": {
                    "type": "object",
                    "default": {},
                    "description": "Configuration for MCP Servers. Format: { \"serverName\": { \"command\": \"...\", \"args\": [...] } }",
                    "order": 8
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "test": "vscode-test",
        "package": "vsce package"
    },
    "devDependencies": {
        "@types/node": "18.x",
        "@types/vscode": "^1.80.0",
        "@typescript-eslint/eslint-plugin": "^6.0.0",
        "@typescript-eslint/parser": "^6.0.0",
        "eslint": "^8.0.0",
        "typescript": "^5.0.0"
    },
    "dependencies": {
        "@langchain/anthropic": "^1.3.3",
        "@langchain/core": "^1.1.8",
        "@langchain/langgraph": "^1.0.7",
        "@langchain/openai": "^1.2.0",
        "@modelcontextprotocol/sdk": "^1.25.1",
        "@types/markdown-it": "^14.1.2",
        "markdown-it": "^14.1.0",
        "zod": "^4.3.5"
    }
}